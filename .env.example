# ---------------------------------------------------------------
# Chula configuration. Copy to .env and fill in what you have.
# Every integration has a local fallback, so the app runs with
# this file empty (in-memory data, simulated Mobile Money,
# rule-based WhatsApp parsing).
# ---------------------------------------------------------------

# --- Supabase (server) -----------------------------------------
# Project Settings > API. The service role key bypasses RLS: keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (browser, baked in at build time) ----------------
# Enables email sign-in in the web app. The anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Flutterwave Mobile Money (MTN MoMo / Airtel Money Uganda) ---
FLUTTERWAVE_SECRET_KEY=
# Dashboard > Settings > Webhooks > "Secret hash". Webhook URL: https://<api-host>/api/payments/webhook
FLUTTERWAVE_SECRET_HASH=
# Optional: where Flutterwave sends customers after a hosted authorisation step.
PAYMENT_REDIRECT_URL=

# --- Gemini (WhatsApp message understanding + bag embeddings) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- WhatsApp Cloud API (Meta) -----------------------------------
# Webhook URL: https://<api-host>/api/whatsapp/webhook
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# App Settings > Basic > App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# --- Server ------------------------------------------------------
PORT=4310
CORS_ORIGINS=http://localhost:5317,http://127.0.0.1:5317,http://localhost:8317
# Fallback switches. Default to true in development, false when NODE_ENV=production.
# ALLOW_IN_MEMORY_STORE=true
# ALLOW_SIMULATED_PAYMENTS=true
# ENABLE_WHATSAPP_SIMULATOR=true
# SIMULATED_PAYMENT_DELAY_MS=4000
# PENDING_ORDER_TIMEOUT_MINUTES=30
